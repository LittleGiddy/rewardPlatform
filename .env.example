# ---- Database (Neon PostgreSQL) ----
# Serverless Postgres connection string. Keep channel_binding + sslmode for Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# ---- Auth ----
# Long random string used to sign user session JWTs. REQUIRED in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# ---- Public site URL ----
# Used to build share/referral links and emails. NO trailing slash.
NEXT_PUBLIC_BASE_URL="https://vunavocha.co.tz"

# ---- Adsterra ad codes ----
# Raw <script>/HTML snippets from the Adsterra dashboard. Leave blank to hide a slot.
NEXT_PUBLIC_ADSTERRA_AD1=""
NEXT_PUBLIC_ADSTERRA_AD2=""
NEXT_PUBLIC_ADSTERRA_AD3=""
NEXT_PUBLIC_ADSTERRA_AD4=""

# ---- Winner notification email (SMTP) ----
EMAIL_USER=""
EMAIL_PASSWORD=""
ADMIN_EMAIL=""

# ---- Admin seeding (used by prisma/seed.mjs) ----
ADMIN_USERNAME="vuna-admin"
ADMIN_PASSWORD="change-me"
ADMIN_EMAIL=""

# ---- Optional: Upstash Redis for API rate limiting ----
# If omitted, rate limiting is disabled (requests are allowed through).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
